{
    "name": "bradietilley/php-builder",
    "description": "A PHP class builder for programmatically generating classes, interfaces, traits, and enums.",
    "keywords": [
        "php",
        "builder",
        "code generation",
        "ast",
        "class"
    ],
    "homepage": "https://github.com/bradietilley/php-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "Bradie Tilley",
            "homepage": "https://github.com/bradietilley",
            "email": "bradietilley@gmail.com"
        }
    ],
    "require": {
        "php": "~8.5.0",
        "bradietilley/php-data": "*",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.18",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0",
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BradieTilley\\Builder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
